# Copy this file to .env and replace every placeholder.
# Get the driver URI from Atlas: your cluster > Connect > Drivers.
# Use a database user (Database Access), not your Atlas website login.
# Add your current IP in Atlas Network Access and URL-encode special
# characters in the database username or password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bookInventory?retryWrites=true&w=majority
